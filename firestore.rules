rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'shriyanshsingh7581@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'defaultCity', 'savedAddresses', 'wishlist', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        (!('defaultCity' in data) || (data.defaultCity is string && data.defaultCity.size() <= 64)) &&
        (!('savedAddresses' in data) || (data.savedAddresses is string && data.savedAddresses.size() <= 2000)) &&
        (!('wishlist' in data) || (data.wishlist is string && data.wishlist.size() <= 1000)) &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'id', 'slug', 'title', 'description', 'categoryId', 'subcategoryId',
          'originalPrice', 'discountedPrice', 'rating', 'reviewsCount',
          'setupDuration', 'primaryImage', 'includedItems', 'isEnabled', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'slug', 'title', 'description', 'categoryId', 'subcategoryId',
          'originalPrice', 'discountedPrice', 'rating', 'reviewsCount',
          'setupDuration', 'primaryImage', 'galleryImages', 'includedItems',
          'excludedItems', 'instructions', 'themeColors', 'isTrending', 'isEnabled', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 160 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 3000 &&
        data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 80 &&
        data.subcategoryId is string && data.subcategoryId.size() >= 1 && data.subcategoryId.size() <= 80 &&
        data.originalPrice is number && data.originalPrice >= 0 &&
        data.discountedPrice is number && data.discountedPrice >= 0 &&
        data.rating is number && data.rating >= 0 && data.rating <= 5 &&
        data.reviewsCount is number && data.reviewsCount >= 0 &&
        data.setupDuration is string && data.setupDuration.size() <= 80 &&
        data.primaryImage is string && data.primaryImage.size() <= 500 &&
        (!('galleryImages' in data) || (data.galleryImages is string && data.galleryImages.size() <= 2500)) &&
        data.includedItems is string && data.includedItems.size() <= 2000 &&
        (!('excludedItems' in data) || (data.excludedItems is string && data.excludedItems.size() <= 1500)) &&
        (!('instructions' in data) || (data.instructions is string && data.instructions.size() <= 1500)) &&
        (!('themeColors' in data) || (data.themeColors is string && data.themeColors.size() <= 500)) &&
        (!('isTrending' in data) || (data.isTrending is bool)) &&
        data.isEnabled is bool &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'slug', 'name', 'description', 'bannerImage', 'subcategoriesJson', 'isEnabled', 'sortOrder', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'slug', 'name', 'description', 'bannerImage', 'subcategoriesJson', 'isEnabled', 'sortOrder', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 120 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.description is string && data.description.size() <= 600 &&
        data.bannerImage is string && data.bannerImage.size() <= 500 &&
        data.subcategoriesJson is string && data.subcategoriesJson.size() <= 3000 &&
        data.isEnabled is bool &&
        data.sortOrder is number &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidAddOn(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'price', 'image', 'isMandatory', 'isEnabled', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'title', 'category', 'price', 'image', 'description', 'isMandatory', 'isEnabled', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.price is number && data.price >= 0 &&
        data.image is string && data.image.size() <= 500 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 400)) &&
        data.isMandatory is bool &&
        data.isEnabled is bool &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidCity(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'state', 'priceMultiplier', 'dailySlotCapacity', 'sameDayCutoffHour', 'isEnabled', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'slug', 'state', 'priceMultiplier', 'dailySlotCapacity', 'sameDayCutoffHour', 'blockedDatesJson', 'isEnabled', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 80 &&
        data.state is string && data.state.size() >= 1 && data.state.size() <= 80 &&
        data.priceMultiplier is number && data.priceMultiplier > 0 &&
        data.dailySlotCapacity is number && data.dailySlotCapacity >= 0 &&
        data.sameDayCutoffHour is number && data.sameDayCutoffHour >= 0 && data.sameDayCutoffHour <= 23 &&
        (!('blockedDatesJson' in data) || (data.blockedDatesJson is string && data.blockedDatesJson.size() <= 2000)) &&
        data.isEnabled is bool &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
          'id', 'orderNumber', 'userId', 'customerName', 'customerPhone', 'customerEmail',
          'cityId', 'cityName', 'eventDate', 'timeSlot', 'venueAddress', 'itemsSummary',
          'subtotal', 'discountAmount', 'totalAmount', 'paymentMode', 'amountPaid',
          'balanceDue', 'paymentStatus', 'orderStatus', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'orderNumber', 'userId', 'customerName', 'customerPhone', 'customerEmail',
          'cityId', 'cityName', 'eventDate', 'timeSlot', 'venueAddress', 'specialInstructions',
          'selectedThemeColor', 'itemsSummary', 'addOnsSummary', 'subtotal', 'discountAmount',
          'couponCode', 'totalAmount', 'paymentMode', 'amountPaid', 'balanceDue',
          'paymentStatus', 'razorpayOrderId', 'razorpayPaymentId', 'orderStatus',
          'assignedDecoratorId', 'assignedDecoratorName', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.orderNumber is string && data.orderNumber.size() >= 1 && data.orderNumber.size() <= 40 &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 30 &&
        data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 160 &&
        data.cityId is string && data.cityId.size() >= 1 && data.cityId.size() <= 80 &&
        data.cityName is string && data.cityName.size() >= 1 && data.cityName.size() <= 80 &&
        data.eventDate is string && data.eventDate.size() >= 8 && data.eventDate.size() <= 20 &&
        data.timeSlot is string && data.timeSlot.size() >= 3 && data.timeSlot.size() <= 50 &&
        data.venueAddress is string && data.venueAddress.size() >= 5 && data.venueAddress.size() <= 600 &&
        (!('specialInstructions' in data) || (data.specialInstructions is string && data.specialInstructions.size() <= 1000)) &&
        (!('selectedThemeColor' in data) || (data.selectedThemeColor is string && data.selectedThemeColor.size() <= 120)) &&
        data.itemsSummary is string && data.itemsSummary.size() >= 2 && data.itemsSummary.size() <= 4000 &&
        (!('addOnsSummary' in data) || (data.addOnsSummary is string && data.addOnsSummary.size() <= 2500)) &&
        data.subtotal is number && data.subtotal >= 0 &&
        data.discountAmount is number && data.discountAmount >= 0 &&
        (!('couponCode' in data) || (data.couponCode is string && data.couponCode.size() <= 40)) &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        data.paymentMode in ['FULL', 'ADVANCE'] &&
        data.amountPaid is number && data.amountPaid >= 0 &&
        data.balanceDue is number && data.balanceDue >= 0 &&
        data.paymentStatus in ['PENDING', 'PARTIAL_VERIFIED', 'PAID_VERIFIED', 'REFUND_PROCESSING', 'REFUNDED', 'FAILED'] &&
        (!('razorpayOrderId' in data) || (data.razorpayOrderId is string && data.razorpayOrderId.size() <= 120)) &&
        (!('razorpayPaymentId' in data) || (data.razorpayPaymentId is string && data.razorpayPaymentId.size() <= 120)) &&
        data.orderStatus in [
          'Pending Payment', 'Payment Received', 'Booking Confirmed', 'Decorator Assigned',
          'Preparation Started', 'Decorator On The Way', 'Setup In Progress', 'Completed',
          'Cancellation Requested', 'Cancelled', 'Refund Processing', 'Refunded'
        ] &&
        (!('assignedDecoratorId' in data) || (data.assignedDecoratorId is string && data.assignedDecoratorId.size() <= 128)) &&
        (!('assignedDecoratorName' in data) || (data.assignedDecoratorName is string && data.assignedDecoratorName.size() <= 120)) &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['id', 'code', 'discountType', 'discountValue', 'minOrderValue', 'expiryDate', 'usageLimit', 'usedCount', 'isEnabled', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'code', 'discountType', 'discountValue', 'minOrderValue', 'maxDiscount', 'expiryDate', 'usageLimit', 'usedCount', 'isEnabled', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.code is string && data.code.size() >= 2 && data.code.size() <= 40 &&
        data.discountType in ['PERCENTAGE', 'FIXED'] &&
        data.discountValue is number && data.discountValue >= 0 &&
        data.minOrderValue is number && data.minOrderValue >= 0 &&
        (!('maxDiscount' in data) || (data.maxDiscount is number && data.maxDiscount >= 0)) &&
        data.expiryDate is string && data.expiryDate.size() <= 40 &&
        data.usageLimit is number && data.usageLimit >= 1 &&
        data.usedCount is number && data.usedCount >= 0 &&
        data.isEnabled is bool &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'productId', 'userId', 'userName', 'city', 'rating', 'comment', 'createdAt']) &&
        data.keys().hasOnly(['id', 'productId', 'userId', 'userName', 'city', 'occasion', 'rating', 'comment', 'createdAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128 && data.productId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
        data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
        (!('occasion' in data) || (data.occasion is string && data.occasion.size() <= 80)) &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 2 && data.comment.size() <= 1000 &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'userEmail', 'requestType', 'subject', 'message', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'userName', 'userEmail', 'orderNumber', 'requestType', 'subject', 'message', 'status', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
        data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 160 &&
        (!('orderNumber' in data) || (data.orderNumber is string && data.orderNumber.size() <= 40)) &&
        data.requestType in ['GENERAL', 'RESCHEDULE', 'CANCELLATION', 'PARTNER'] &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 160 &&
        data.message is string && data.message.size() >= 2 && data.message.size() <= 1500 &&
        data.status in ['OPEN', 'IN_PROGRESS', 'RESOLVED', 'CLOSED'] &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidDecorator(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'cityId', 'cityName', 'specialty', 'rating', 'isAvailable', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'phone', 'cityId', 'cityName', 'specialty', 'rating', 'isAvailable', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30 &&
        data.cityId is string && data.cityId.size() >= 1 && data.cityId.size() <= 80 &&
        data.cityName is string && data.cityName.size() >= 1 && data.cityName.size() <= 80 &&
        data.specialty is string && data.specialty.size() >= 1 && data.specialty.size() <= 120 &&
        data.rating is number && data.rating >= 0 && data.rating <= 5 &&
        data.isAvailable is bool &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidWebsiteSetting(data) {
      return data.keys().hasAll(['id', 'brandName', 'announcementText', 'supportPhone', 'whatsappNumber', 'supportEmail', 'advancePercentage', 'allowAdvancePayment', 'cancellationPolicySummary', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'brandName', 'announcementText', 'supportPhone', 'whatsappNumber', 'supportEmail', 'advancePercentage', 'allowAdvancePayment', 'cancellationPolicySummary', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.brandName is string && data.brandName.size() >= 1 && data.brandName.size() <= 80 &&
        data.announcementText is string && data.announcementText.size() <= 250 &&
        data.supportPhone is string && data.supportPhone.size() <= 30 &&
        data.whatsappNumber is string && data.whatsappNumber.size() <= 30 &&
        data.supportEmail is string && data.supportEmail.size() <= 160 &&
        data.advancePercentage is number && data.advancePercentage >= 10 && data.advancePercentage <= 100 &&
        data.allowAdvancePayment is bool &&
        data.cancellationPolicySummary is string && data.cancellationPolicySummary.size() <= 1000 &&
        data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(userId) && isValidUser(incoming()) && incoming().uid == request.auth.uid && userId == request.auth.uid;
      allow update: if isVerifiedUser() && isValidId(userId) && isValidUser(incoming()) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt && (
        isAdmin() ||
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'defaultCity', 'savedAddresses', 'wishlist', 'updatedAt']))
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(adminId) && isAdmin() && isValidAdmin(incoming());
      allow delete: if isValidId(adminId) && isAdmin();
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create, update: if isValidId(productId) && isAdmin() && isValidProduct(incoming()) && incoming().id == productId;
      allow delete: if isValidId(productId) && isAdmin();
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create, update: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming()) && incoming().id == categoryId;
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    match /addOns/{addonId} {
      allow get: if isValidId(addonId);
      allow list: if true;
      allow create, update: if isValidId(addonId) && isAdmin() && isValidAddOn(incoming()) && incoming().id == addonId;
      allow delete: if isValidId(addonId) && isAdmin();
    }

    match /cities/{cityId} {
      allow get: if isValidId(cityId);
      allow list: if true;
      allow create, update: if isValidId(cityId) && isAdmin() && isValidCity(incoming()) && incoming().id == cityId;
      allow delete: if isValidId(cityId) && isAdmin();
    }

    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(bookingId) && isValidBooking(incoming()) && incoming().id == bookingId && incoming().userId == request.auth.uid;
      allow update: if isVerifiedUser() && isValidId(bookingId) && isValidBooking(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().orderNumber == existing().orderNumber &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            !(existing().orderStatus in ['Completed', 'Cancelled', 'Refunded']) && (
              // Action 1: Customer Cancellation or Reschedule Request
              (
                incoming().orderStatus == 'Cancellation Requested' &&
                incoming().diff(existing()).affectedKeys().hasOnly(['orderStatus', 'specialInstructions', 'updatedAt'])
              ) ||
              // Action 2: Verified Razorpay Payment Update
              (
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'paymentStatus', 'amountPaid', 'balanceDue', 'razorpayOrderId', 'razorpayPaymentId', 'orderStatus', 'updatedAt'
                ])
              )
            )
          )
        );
      allow delete: if isValidId(bookingId) && isAdmin();
    }

    match /coupons/{couponId} {
      allow get: if isValidId(couponId);
      allow list: if true;
      allow create, update: if isValidId(couponId) && isAdmin() && isValidCoupon(incoming()) && incoming().id == couponId;
      allow delete: if isValidId(couponId) && isAdmin();
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isVerifiedUser() && isValidId(reviewId) && isValidReview(incoming()) && incoming().id == reviewId && incoming().userId == request.auth.uid;
      allow update: if isVerifiedUser() && isValidId(reviewId) && isValidReview(incoming()) && incoming().id == existing().id && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt && (
        isAdmin() ||
        (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment']))
      );
      allow delete: if isValidId(reviewId) && isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow get: if isValidId(ticketId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(ticketId) && isValidSupportTicket(incoming()) && incoming().id == ticketId && incoming().userId == request.auth.uid;
      allow update: if isVerifiedUser() && isValidId(ticketId) && isValidSupportTicket(incoming()) && incoming().id == existing().id && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt && (
        isAdmin() ||
        (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['message', 'status', 'updatedAt']))
      );
      allow delete: if isValidId(ticketId) && isAdmin();
    }

    match /decorators/{decoratorId} {
      allow get: if isValidId(decoratorId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(decoratorId) && isAdmin() && isValidDecorator(incoming()) && incoming().id == decoratorId;
      allow delete: if isValidId(decoratorId) && isAdmin();
    }

    match /websiteSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update: if isValidId(settingId) && isAdmin() && isValidWebsiteSetting(incoming()) && incoming().id == settingId;
      allow delete: if isValidId(settingId) && isAdmin();
    }
  }
}
